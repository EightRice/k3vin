[Unit]
Description=K3V|N Discord Bot + Hackathon API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/k3vin
EnvironmentFile=/home/ubuntu/k3vin/.env
ExecStart=/usr/bin/python3 main.py --no-emulator
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
